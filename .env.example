# Template only — no real values. Copy to `.env` for local runs (gitignored)
# or paste these names into Coolify's environment variables panel. See
# docs/deploy.md for what each one is and where its value comes from.

# --- Already exist in the owner's local .env; carry the same values over ---
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_ID=

# --- New for this ticket ---
# Shared secret in the webhook path (/webhook/<secret>). Generate with e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
WEBHOOK_SECRET=

# Evolution GO's base URL on the shared network. REQUIRED — no default,
# because Coolify's "Connect to Predefined Networks" breaks short-name DNS,
# so the short `http://evolution-go:8080` will not resolve. Use the
# fully-qualified name (docs/deploy.md, Step 4):
#   http://evolution-go-ohilulk0h2zy70nhcc536np4:8080
EVOLUTION_URL=

# Where Evolution GO posts webhooks to reach Bella. REQUIRED — no default,
# same DNS reason, and a wrong value fails SILENTLY (no error; webhooks just
# never arrive). Read Bella's real container name off her deployment first —
# docs/deploy.md, Step 6 — then set:
#   http://<bella-container-name>:8000
BELLA_INTERNAL_URL=

# WhatsApp display name to set via bella/scripts/set_presentation.py.
BELLA_DISPLAY_NAME=Bella

# Where the profile-picture asset lives. The Dockerfile sets this itself;
# leave unset for a source checkout (config.py falls back to the repo root).
# PROFILE_PICTURE_PATH=
