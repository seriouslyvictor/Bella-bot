# Bella Bot unified stack
#
# Copy this file to .env for local Docker runs, or create the same variables
# in Coolify. Leave real values out of git. The Compose file fails fast when a
# required value is missing.

# Required stack secrets ----------------------------------------------------

# Administrator credential used by the Postgres container. On a retained
# volume, rotate the role as documented in docs/deploy.md before changing this
# value. A 32-byte hex value works well:
#   python -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_PASSWORD=

# Application-specific database roles enforce the boundary between Bella's
# conversation history and Evolution's auth/users databases. Generate a
# different URL-safe value for each role. On a retained volume, follow the
# password-rotation procedure in docs/deploy.md; changing only this file does
# not alter an existing Postgres role.
BELLA_DB_PASSWORD=
EVOLUTION_DB_PASSWORD=

# Evolution's role-only circuit breakers. Changing either default is a
# capacity decision and requires rerunning the reconnect/idle-timeout tests.
EVOLUTION_DB_CONNECTION_LIMIT=30
EVOLUTION_DB_IDLE_SESSION_TIMEOUT=5min

# Evolution Go administrative key, used only by Evolution Go/Manager.
# Generate independently from the instance token below:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
EVOLUTION_GLOBAL_API_KEY=

# Token assigned to Bella's Evolution Go instance. Bella uses it on the
# /instance/connect, /send/*, and /user/* routes. This is NOT the global key.
EVOLUTION_API_KEY=

# Evolution GO selects the instance by the token above and ignores this
# header. Keep the actual UUID when known; this placeholder is valid at first
# boot and can be replaced after creating the instance.
EVOLUTION_INSTANCE_ID=unused-by-evolution-go

# Claude credential used by Bella's Scope Gate and answerer.
ANTHROPIC_API_KEY=

# WhatsApp number that receives handoff notifications, digits only with country
# code and area code (for example, 5511999999999).
ADMIN_CONTACT=

# Optional Bella settings ---------------------------------------------------

BELLA_DISPLAY_NAME=Bella

# The content directory is bind-mounted read-only into Bella, so adding or
# replacing this file is picked up on the next request without an image rebuild.
APOSTILA_PATH=/app/content/apostila.pdf

# Per-number sliding-window protection for inbound messages.
RATE_LIMIT_MAX_MESSAGES=10
RATE_LIMIT_WINDOW_SECONDS=60
TAKEOVER_PAUSE_SECONDS=3600

# Optional Evolution GO 0.7.2-pr117 settings -------------------------------

EVOLUTION_CONNECT_ON_STARTUP=true
EVOLUTION_DATABASE_SAVE_MESSAGES=false
EVOLUTION_DEBUG_LEVEL=INFO
EVOLUTION_OS_NAME=Evolution GO
EVOLUTION_QRCODE_MAX_COUNT=5

# Local Docker Engine ports -------------------------------------------------
# Used only with docker-compose.local.yml. All bindings are loopback-only.

POSTGRES_HOST_PORT=5432
EVOLUTION_HOST_PORT=8080
BELLA_HOST_PORT=8000
