# Template only — no real values. Copy to `.env` for local runs (gitignored)
# or paste these names into Coolify's environment variables panel. See
# docs/deploy.md for what each one is and where its value comes from.

# The Evolution GO INSTANCE token — the `token` the instance was created
# with. NOT the stack's GLOBAL_API_KEY: everything Bella calls (/send/text,
# /instance/connect, /user/*) sits behind evolution-go's Auth middleware,
# which looks the instance up BY this token. The global key 401s there.
# The published webhook docs say to use GLOBAL_API_KEY here; they're wrong.
# Find it (this call does take the global key):
#   curl -H "apikey: <GLOBAL_API_KEY>" http://evolution-go:8080/instance/all
# and read the `token` field of your instance. See docs/deploy.md.
EVOLUTION_API_KEY=

# The instance UUID. Sent as an `instanceId` header for documentation parity
# only — the current evolution-go ignores it and selects the instance purely
# from the token above. Changing this does NOT re-target another instance.
EVOLUTION_INSTANCE_ID=

# Claude API credential used by the Scope Gate classifier. Required from
# ticket 04 onward; keep it secret/masked in Coolify.
ANTHROPIC_API_KEY=

# Shared secret in the webhook path (/webhook/<secret>). Generate with e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
WEBHOOK_SECRET=

# Evolution GO's base URL on the shared network. REQUIRED (no default).
# Its container carries both aliases, so either of these works:
#   http://evolution-go:8080
#   http://evolution-go-ohilulk0h2zy70nhcc536np4:8080
EVOLUTION_URL=

# Where Evolution GO posts webhooks to reach Bella. REQUIRED (no default).
# Must match the `bella` network alias in docker-compose.yml — a mismatch
# fails SILENTLY (no error; webhooks just never arrive). Do NOT use Bella's
# container name here: Coolify regenerates it with a fresh timestamp on every
# redeploy, which would break inbound messages each time. So:
#   http://bella:8000
BELLA_INTERNAL_URL=

# WhatsApp display name to set via bella/scripts/set_presentation.py.
BELLA_DISPLAY_NAME=Bella

# Where the profile-picture asset lives. The Dockerfile sets this itself;
# leave unset for a source checkout (config.py falls back to the repo root).
# PROFILE_PICTURE_PATH=
