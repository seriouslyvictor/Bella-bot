# Template only — no real values. Copy to `.env` for local runs (gitignored)
# or paste these names into Coolify's environment variables panel. See
# docs/deploy.md for what each one is and where its value comes from.

# --- Already exist in the owner's local .env; carry the same values over ---
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_ID=

# --- New for this ticket ---
# Shared secret in the webhook path (/webhook/<secret>). Generate with e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
WEBHOOK_SECRET=

# Internal Evolution GO base URL on the shared Docker network. Defaults to
# http://evolution-go:8080 if unset — override only if the Evolution stack's
# service name differs.
EVOLUTION_URL=

# Where Evolution GO can reach Bella on that same network. Defaults to
# http://bella:8000 if unset — override to match whatever hostname Coolify
# actually gives the Bella container (see docs/deploy.md).
BELLA_INTERNAL_URL=

# WhatsApp display name to set via bella/scripts/set_presentation.py.
BELLA_DISPLAY_NAME=Bella
